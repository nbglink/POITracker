# Copy to backend/.env and fill in as needed
# All backend settings are read with the MT5_ prefix

# Safety: MUST be true AND UI must be armed to execute orders
MT5_EXECUTION_ENABLED=false

# Optional: auto-login (recommended to login in the terminal UI instead)
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=YourBroker-Server

# Optional: explicit terminal path (if needed)
# MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

# Server
MT5_HOST=127.0.0.1
MT5_PORT=8000
MT5_DEBUG=false
