# Copy to backend/.env and fill in as needed.
# All backend settings are read with the MT5_ prefix.

# Safety: MUST be true AND the UI must be armed to execute orders.
MT5_EXECUTION_ENABLED=false

# Optional auto-login (recommended to login in the MT5 terminal UI instead).
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=YourBroker-Server

# Optional TP1 watcher tuning (defaults are usually fine).
# MT5_TP1_PIPS_DEFAULT=30.0
# MT5_TP1_PERCENT_DEFAULT=50.0
# MT5_TP1_BE_BUFFER_PIPS=0.0
# MT5_TP1_POLL_INTERVAL_S=0.5
